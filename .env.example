GEMINI_API_KEY=your_gemini_api_key_here
QDRANT_URL=https://your-cluster-url.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=course_chunks
PORT=3001

# Set this to your deployed frontend URL once you deploy (e.g. Vercel URL).
# Restricts CORS so only your frontend can call this backend. Leave unset
# during local dev - it defaults to allowing all origins.
FRONTEND_URL=https://your-app.vercel.app