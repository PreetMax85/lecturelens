{
  "name": "lecturelens",
  "version": "1.0.0",
  "description": "Advanced RAG chatbot over Udemy course SRT/VTT files with timestamp citations",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/prefetch-model.js",
    "ingest": "node src/ingest.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "eval": "node eval/run.js",
    "perf": "node eval/perf.js",
    "eval:guardrail": "node eval/guardrail.js",
    "eval:rerank-bakeoff": "node eval/rerank-bakeoff.js",
    "test": "node --test \"src/**/*.test.js\" \"eval/**/*.test.js\" \"frontend/src/**/*.test.js\""
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0"
  }
}
